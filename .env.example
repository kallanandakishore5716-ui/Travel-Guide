# Copy this file to .env and fill in real values for LOCAL development.
# Never commit .env. In production (Render), set these in the dashboard instead.

# Google AI Studio / Gemini API key (used by Backend/app.py only)
GEMINI_API_KEY=your-gemini-api-key-here

# Murf AI API key (used by Backend/app.py only)
MURF_API_KEY=your-murf-api-key-here

# Comma-separated browser origins allowed to call the API (CORS).
# Optional locally - the code already allows common local origins.
# Required in production: set to your Vercel URL.
# FRONTEND_ORIGINS=https://your-project.vercel.app
